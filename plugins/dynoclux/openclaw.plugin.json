{
  "id": "dynoclux",
  "name": "DynoClux Privacy Enforcement",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "dynoclux_check_violations",
      "dynoclux_evidence_log",
      "dynoclux_generate_notice",
      "dynoclux_list_requests",
      "dynoclux_noise_report",
      "dynoclux_process_queue",
      "dynoclux_scan_inbox",
      "dynoclux_track_request",
      "dynoclux_unsubscribe"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "gmailClientId": {
        "type": "string"
      },
      "gmailClientSecret": {
        "type": "string"
      },
      "gmailRefreshToken": {
        "type": "string"
      },
      "convexUrl": {
        "type": "string"
      }
    },
    "required": [
      "gmailClientId",
      "gmailClientSecret",
      "gmailRefreshToken",
      "convexUrl"
    ]
  }
}
