{
  "id": "beehiiv",
  "name": "Beehiiv Newsletter",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "beehiiv_create_draft",
      "beehiiv_get_post",
      "beehiiv_list_posts"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
